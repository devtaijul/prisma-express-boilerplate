// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  createdAt DateTime  @default(now())
  sessions  Session[]
}

model Session {
  id           String   @id @default(uuid())
  refreshToken String   @unique
  expiresAt    DateTime
  userId       String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Media {
  id                 String     @id @default(uuid())
  url                String     @unique
  filename           String
  mimeType           String
  size               Int
  width              Int?
  height             Int?
  altText            String?
  caption            String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  categories         Category[]
  featuredInProducts Product[]  @relation("FeaturedImage")
  galleryOfProducts  Product[]  @relation("GalleryImages")
  productId          String?

  @@map("media")
}

// Optional: যদি Products, Categories ইত্যাদি manage করেন
model Product {
  id String @id @default(uuid())

  /**
   * ================= BASIC =================
   */
  title      String
  slug       String     @unique
  category   Category   @relation(fields: [categoryId], references: [id])
  categoryId String
  stitchType StitchType

  /**
   * ================= VARIANT =================
   */
  sizes String[] @default([])

  /**
   * ================= PRICING =================
   */
  regularPrice Float
  price        Float

  /**
   * ================= STOCK =================
   */
  inStock Boolean @default(true)
  sku     String?

  /**
   * ================= FLAGS =================
   */
  isTopSelling      Boolean @default(false)
  newArrival        Boolean @default(false)
  isCustomeRelation Boolean @default(false)

  /**
   * ================= VISUAL =================
   */
  color           String?
  manufacturer    String?
  displayPriority String?

  /**
   * ================= KEYWORDS =================
   */
  keywords String[] @default([])

  /**
   * ================= MEASUREMENTS =================
   */
  body           String?
  pantLong       String?
  kamizLong      String?
  innerAndSalwar String?

  /**
   * ================= CONTENT =================
   */
  description Json
  instruction Json?
  videoUrl    String?
  liveLink    String?

  /**
   * ================= SEO =================
   */
  seoTitle       String?
  seoDescription String?

  /**
   * ================= MEDIA =================
   */
  featuredImageId String?
  featuredImage   Media?  @relation("FeaturedImage", fields: [featuredImageId], references: [id])

  galleryImages Media[] @relation("GalleryImages")

  /**
   * ================= ATTACHED PRODUCT =================
   * One product can be attached to ONE other product
   */
  attachProductId   String?  @unique // Added @unique for one-to-one relation
  attachProduct     Product? @relation("AttachedProduct", fields: [attachProductId], references: [id])
  attachedToProduct Product? @relation("AttachedProduct") // Reverse relation

  /**
   * ================= RELATED PRODUCTS =================
   * Many-to-many relation for related products
   */
  relatedProducts   Product[] @relation("RelatedProducts")
  relatedToProducts Product[] @relation("RelatedProducts")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("products")
}

enum StitchType {
  STITCH
  UNSTITCH
}

model Category {
  id          String  @id @default(cuid())
  title       String
  slug        String  @unique
  description String?

  // Media connections
  featuredImage   Media?  @relation(fields: [featuredImageId], references: [id])
  featuredImageId String?

  seoTitle       String?
  seoDescription String?

  parentId String?
  parent   Category?  @relation("CategoryToParent", fields: [parentId], references: [id])
  children Category[] @relation("CategoryToParent")

  isPublished Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}
